<mujoco model="allegro inhand multi-object scene">
  <!-- All three objects live in every env. At reset one object (per env) is
       placed on the palm and the other two are parked on the floor, far from
       the hand. UniLab's fixed model variants cannot mix geom types, so this is
       how a single policy sees ball, cube and cylinder in one training pool. -->
  <include file="allegro_right.xml"/>
  <include file="ball_multi.xml"/>
  <include file="cube_multi.xml"/>
  <include file="cylinder_multi.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.2" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <!--
    qpos layout (nq = 16 hand + 3 x 7 free objects = 37), free joints in include order:
      [0:16]  hand joint angles: ff(4) mf(4) rf(4) th(4)
      [16:23] ball     x y z qw qx qy qz
      [23:30] cube     x y z qw qx qy qz
      [30:37] cylinder x y z qw qx qy qz
    The keyframe holds the ball on the palm and parks cube and cylinder on the
    floor (z = -0.2 + half height); the reset event reassigns per env.
  -->
  <keyframe>
    <key name="home"
      qpos="0.082 1.244 0.265 0.298
            0.005 1.096 0.080 0.150
            0.029 1.337 0.285 0.317
            1.104 1.163 0.953 -0.138
            -0.01 -0.01 0.13   1 0 0 0
             0.6   0.0 -0.165  1 0 0 0
            -0.6   0.0 -0.165  1 0 0 0"
      ctrl="0.082 1.244 0.265 0.298
            0.005 1.096 0.080 0.150
            0.029 1.337 0.285 0.317
            1.104 1.163 0.953 -0.138"/>
  </keyframe>
</mujoco>
